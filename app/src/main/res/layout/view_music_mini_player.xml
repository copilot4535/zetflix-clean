<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_mini_player"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/player_surface_base"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp"
    android:visibility="gone"
    tools:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/music_mini_thumbnail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerCrop"
            android:transitionName="album_art"
            app:shapeAppearanceOverlay="@style/MusicMiniAlbumArtStyle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/default_cover"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/music_mini_metadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/music_mini_devices"
            app:layout_constraintStart_toEndOf="@id/music_mini_thumbnail"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/music_mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:fontFamily="@font/metropolis_bold"
                android:textColor="@color/player_text_primary"
                android:textSize="13sp"
                tools:text="Blinding Lights - Major Lazer Remix" />

            <TextView
                android:id="@+id/music_mini_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/metropolis_regular"
                android:maxLines="1"
                android:textColor="@color/player_text_secondary"
                android:textSize="11sp"
                tools:text="The Weeknd, Major Lazer" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/music_mini_devices"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_tv_24"
            android:alpha="0.8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/music_mini_like"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/player_text_primary"
            android:padding="6dp"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/music_mini_like"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_add_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/music_mini_play_pause_container"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/player_text_primary"
            android:padding="6dp"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription" />

        <FrameLayout
            android:id="@+id/music_mini_play_pause_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/music_mini_play_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_baseline_play_arrow_24"
                app:tint="@color/player_text_primary"
                android:scaleType="fitCenter"
                tools:ignore="ContentDescription" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/music_mini_loading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="24dp"
                app:trackThickness="2.5dp"
                app:indicatorColor="@color/player_text_primary" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/music_mini_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="12dp"
            android:progress="0"
            android:progressDrawable="@drawable/music_mini_progress_drawable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
