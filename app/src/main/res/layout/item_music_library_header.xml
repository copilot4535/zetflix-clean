<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/library_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/library_header_icon_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/music_surface_dark">

        <ImageView
            android:id="@+id/library_header_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            app:tint="@color/zetflix_accent"
            tools:src="@drawable/ic_baseline_favorite_24"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/library_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/metropolis_medium"
        android:textColor="@color/white"
        android:textSize="16sp"
        tools:text="Liked Songs" />

    <ImageButton
        android:id="@+id/library_header_action_1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        app:tint="@color/white"
        tools:visibility="visible"
        tools:src="@drawable/ic_baseline_add_24" />

    <ImageButton
        android:id="@+id/library_header_action_2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        app:tint="@color/white"
        tools:visibility="visible"
        tools:src="@drawable/baseline_save_as_24" />
</LinearLayout>
