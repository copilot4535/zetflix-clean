<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/zetflix_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sleep Timer"
        android:textColor="@color/zetflix_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_off"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Turn Off"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@color/zetflix_surface"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_15"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="15 Minutes"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@color/zetflix_surface"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_30"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="30 Minutes"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@color/zetflix_surface"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_60"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="60 Minutes"
        android:layout_marginBottom="16dp"
        app:backgroundTint="@color/zetflix_surface"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Custom Minutes"
        android:textColor="@color/zetflix_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/custom_timer_input_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:boxStrokeColor="@color/zetflix_accent"
            app:hintTextColor="@color/zetflix_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/custom_timer_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter minutes"
                android:inputType="number"
                android:textColor="@color/zetflix_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timer_custom_set"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Set"
            app:backgroundTint="@color/zetflix_accent"/>
    </LinearLayout>

</LinearLayout>
