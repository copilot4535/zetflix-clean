<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/standing_pos"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="1" />

    <ImageView
        android:id="@+id/standing_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        tools:src="@drawable/default_cover" />

    <TextView
        android:id="@+id/standing_team_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="@color/white"
        android:textSize="14sp"
        tools:text="Team Name" />

    <TextView
        android:id="@+id/standing_played"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/zetflix_text_secondary"
        android:textSize="12sp"
        tools:text="24" />

    <TextView
        android:id="@+id/standing_gd"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/zetflix_text_secondary"
        android:textSize="12sp"
        tools:text="+31" />

    <TextView
        android:id="@+id/standing_pts"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="58" />

</LinearLayout>
