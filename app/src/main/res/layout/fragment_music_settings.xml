<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_background_black"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/music_settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
        app:title="Music Settings"
        app:titleTextColor="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.ZetFlix.H3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="General"
                android:textColor="@color/zetflix_accent"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/music_setting_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Audio Quality"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/metropolis_medium" />

                <TextView
                    android:id="@+id/music_setting_quality_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="High (Requires fast internet)"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/zetflix_white_20"
                android:layout_marginVertical="8dp" />

            <TextView
                style="@style/TextAppearance.ZetFlix.H3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account &amp; Region"
                android:textColor="@color/zetflix_accent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/music_setting_region"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Region"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/metropolis_medium" />

                <TextView
                    android:id="@+id/music_setting_region_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="United States (en-US)"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/music_setting_cookie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YouTube Music Cookie"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/metropolis_medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import cookie for your personalized library"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/zetflix_white_20"
                android:layout_marginVertical="8dp" />

            <TextView
                style="@style/TextAppearance.ZetFlix.H3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cache"
                android:textColor="@color/zetflix_accent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/music_setting_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear Music Cache"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/metropolis_medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Free up space by removing cached images and data"
                    android:textColor="@color/music_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
