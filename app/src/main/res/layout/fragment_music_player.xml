<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/music_player_background_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1.0"
        android:background="@drawable/music_player_default_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:translationZ="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/music_player_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Minimize player" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now Playing"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:fontFamily="@font/metropolis_bold"
            app:layout_constraintBottom_toBottomOf="@id/music_player_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/music_player_back" />

        <ImageButton
            android:id="@+id/music_player_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_more_vert_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:contentDescription="@string/episode_more_options_des" />

        <TextView
            android:id="@+id/music_player_sleep_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/zetflix_accent"
            android:textSize="12sp"
            android:fontFamily="@font/metropolis_bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/music_player_more"
            app:layout_constraintTop_toBottomOf="@id/music_player_more"
            android:layout_marginTop="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/music_player_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/music_player_top_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/music_player_album_art_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="16dp"
                android:transitionName="album_art"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/music_player_album_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Album Art"
                        tools:src="@drawable/default_cover" />

                    <!-- Canvas Placeholder (Video View would go here) -->
                    <View
                        android:id="@+id/music_player_canvas_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/music_player_live_lyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/metropolis_bold"
                android:gravity="center"
                android:lines="1"
                android:minLines="1"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/music_player_album_art_card"
                tools:text="Active lyric line"
                tools:visibility="visible" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/music_player_metadata_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/music_player_live_lyric">

                <TextView
                    android:id="@+id/music_player_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:fontFamily="@font/metropolis_bold"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="2"
                    app:layout_constraintEnd_toStartOf="@id/music_player_like"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Song Title" />

                <TextView
                    android:id="@+id/music_player_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#B4B4BE"
                    android:textSize="16sp"
                    android:fontFamily="@font/metropolis_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    app:layout_constraintEnd_toStartOf="@id/music_player_like"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/music_player_title"
                    tools:text="Artist Name" />

                <ImageButton
                    android:id="@+id/music_player_like"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_baseline_favorite_border_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white"
                    android:contentDescription="Like" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.media3.ui.PlayerView
                android:id="@+id/music_player_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/music_player_metadata_container"
                app:surface_type="none"
                app:use_controller="true"
                app:shutter_background_color="@android:color/transparent"
                app:controller_layout_id="@layout/custom_music_controls"
                app:show_timeout="0"
                app:hide_on_touch="false" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/music_player_lyrics_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="#4D000000"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/music_player_view"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="28dp">

                    <TextView
                        android:id="@+id/music_player_lyrics_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LYRICS"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="@font/metropolis_bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/music_player_lyrics_snippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/metropolis_bold"
                        android:maxLines="5"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:lineSpacingMultiplier="1.2"
                        tools:text="This is a snippet of the lyrics that will be displayed here in a large, bold format..." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About the Song Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/music_player_about_song_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="#26FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/music_player_lyrics_preview"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/music_player_about_song_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ABOUT THE SONG"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="@font/metropolis_bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/music_player_about_song_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/metropolis_regular"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        tools:text="Story behind the song content goes here..." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SongDNA Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/music_player_song_dna_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="#26FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/music_player_about_song_card"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/music_player_song_dna_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SONGDNA"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="@font/metropolis_bold"
                        android:letterSpacing="0.1" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/music_player_song_dna_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:listitem="@layout/item_music_player_header" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
