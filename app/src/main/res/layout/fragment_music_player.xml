<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/music_player_background_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1.0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/music_player_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_metadata_scrim_netflix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:elevation="8dp"
        android:translationZ="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/music_player_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:contentDescription="@string/go_back" />

        <ImageButton
            android:id="@+id/music_player_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_more_vert_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:contentDescription="@string/episode_more_options_des" />

        <TextView
            android:id="@+id/music_player_sleep_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/zetflix_accent"
            android:textSize="12sp"
            android:fontFamily="@font/metropolis_bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/music_player_more"
            app:layout_constraintTop_toBottomOf="@id/music_player_more"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now Playing"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/metropolis_bold"
            app:layout_constraintBottom_toBottomOf="@id/music_player_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/music_player_back" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/music_player_album_art_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/music_player_top_bar">

        <ImageView
            android:id="@+id/music_player_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:transitionName="album_art"
            android:contentDescription="Album Art"
            tools:src="@drawable/default_cover" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/music_player_metadata_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/music_player_album_art_card">

        <TextView
            android:id="@+id/music_player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:fontFamily="@font/metropolis_bold"
            android:gravity="center"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            tools:text="Song Title" />

        <TextView
            android:id="@+id/music_player_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/music_text_secondary"
            android:textSize="18sp"
            android:fontFamily="@font/metropolis_regular"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            tools:text="Artist Name" />

        <TextView
            android:id="@+id/music_player_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/music_text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/metropolis_regular"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="Album Name"
            tools:visibility="visible" />

    </LinearLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/music_player_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:surface_type="none"
        app:use_controller="true"
        app:controller_layout_id="@layout/custom_music_controls"
        app:show_timeout="0"
        app:hide_on_touch="false" />

</androidx.constraintlayout.widget.ConstraintLayout>
