<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/music_player_background_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1.0"
        android:background="@drawable/music_player_default_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:translationZ="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/music_player_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Minimize player" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/music_player_back"
            app:layout_constraintEnd_toStartOf="@id/music_player_more"
            app:layout_constraintStart_toEndOf="@id/music_player_back"
            app:layout_constraintTop_toTopOf="@id/music_player_back">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playing from Album"
                android:textColor="@color/player_text_secondary"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:fontFamily="@font/metropolis_bold" />

            <TextView
                android:id="@+id/music_player_album_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:fontFamily="@font/metropolis_bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Blinding Lights" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/music_player_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_more_vert_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:contentDescription="@string/episode_more_options_des" />

        <TextView
            android:id="@+id/music_player_sleep_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/zetflix_accent"
            android:textSize="12sp"
            android:fontFamily="@font/metropolis_bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/music_player_more"
            app:layout_constraintTop_toBottomOf="@id/music_player_more"
            android:layout_marginTop="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/music_player_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/music_player_top_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/music_player_album_art"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:scaleType="centerCrop"
                android:contentDescription="Album Art"
                android:transitionName="album_art"
                app:shapeAppearanceOverlay="@style/MusicAlbumArtStyle"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/default_cover" />

            <TextView
                android:id="@+id/music_player_live_lyric"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/metropolis_bold"
                android:gravity="start"
                android:textColor="@color/player_text_primary"
                android:textSize="20sp"
                android:alpha="1.0"
                android:lines="2"
                android:minLines="2"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/music_player_album_art"
                tools:text="Active lyric line 1\nActive lyric line 2" />

            <TextView
                android:id="@+id/music_player_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/player_text_primary"
                android:textSize="22sp"
                android:fontFamily="@font/metropolis_bold"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="2"
                app:layout_constraintEnd_toStartOf="@id/music_player_like"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/music_player_live_lyric"
                tools:text="Song Title" />

            <TextView
                android:id="@+id/music_player_artist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/player_text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/metropolis_regular"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintEnd_toStartOf="@id/music_player_like"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/music_player_title"
                tools:text="Artist Name" />

            <ImageButton
                android:id="@+id/music_player_like"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_baseline_add_24"
                app:layout_constraintBottom_toBottomOf="@id/music_player_artist"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/music_player_title"
                app:tint="@color/player_text_primary"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Like" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/music_player_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                app:layout_constraintTop_toBottomOf="@id/music_player_artist"
                app:surface_type="none"
                app:use_controller="true"
                app:shutter_background_color="@android:color/transparent"
                app:controller_layout_id="@layout/custom_music_controls"
                app:show_timeout="0"
                app:hide_on_touch="false" />

            <!-- Lyrics Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/music_player_lyrics_preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="#4D000000"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/music_player_view"
                tools:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp">

                    <TextView
                        android:id="@+id/music_player_lyrics_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lyrics preview"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/metropolis_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/music_player_lyrics_snippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/metropolis_bold"
                        android:maxLines="5"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:lineSpacingMultiplier="1.2"
                        app:layout_constraintTop_toBottomOf="@id/music_player_lyrics_label"
                        tools:text="First things first, I ma say all the words inside my head\nI'm fired up, and tired of the way that things have been, oh-ooh\nThe way that things have been, oh-ooh" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music_player_show_lyrics_button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="20dp"
                        android:text="Show lyrics"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:paddingHorizontal="20dp"
                        android:fontFamily="@font/metropolis_bold"
                        android:textColor="@color/black"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/music_player_lyrics_snippet"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SongDNA Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/music_player_song_dna_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="#26FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/music_player_lyrics_preview_card"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/music_player_song_dna_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SONGDNA"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="@font/metropolis_bold"
                        android:letterSpacing="0.1" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/music_player_song_dna_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:listitem="@layout/item_music_player_header" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
