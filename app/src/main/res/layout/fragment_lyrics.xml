<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <View
        android:id="@+id/lyrics_background_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/music_player_default_background" />

    <View
        android:id="@+id/lyrics_background_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000" />

    <!-- Anchored Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lyrics_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/lyrics_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/white"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Minimize lyrics" />

        <LinearLayout
            android:id="@+id/lyrics_metadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lyrics_thumbnail_card"
            app:layout_constraintStart_toEndOf="@id/lyrics_close"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/lyrics_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/metropolis_bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Song Title" />

            <TextView
                android:id="@+id/lyrics_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3B3B3"
                android:textSize="12sp"
                android:fontFamily="@font/metropolis_medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Artist Name" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lyrics_thumbnail_card"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/lyrics_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/default_cover" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Anchored Bottom Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lyrics_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/music_lyrics_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_outline_share_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:alpha="0.8"
            android:contentDescription="Share Lyrics" />

        <ImageButton
            android:id="@+id/music_lyrics_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_more_vert_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:alpha="0.8"
            android:contentDescription="More" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/lyrics_exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:scrubber_color="@color/white"
            app:played_color="@color/white"
            app:unplayed_color="#33FFFFFF"
            app:bar_height="2dp"
            app:layout_constraintTop_toBottomOf="@id/music_lyrics_share" />

        <TextView
            android:id="@+id/lyrics_exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B3B3B3"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lyrics_exo_progress"
            tools:text="0:00" />

        <TextView
            android:id="@+id/lyrics_exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B3B3B3"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lyrics_exo_progress"
            tools:text="3:45" />

        <FrameLayout
            android:id="@+id/lyrics_play_pause_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lyrics_exo_position">

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_white" />

            <ImageButton
                android:id="@+id/lyrics_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_baseline_play_arrow_24"
                android:padding="16dp"
                android:scaleType="fitCenter"
                app:tint="@color/black"
                android:contentDescription="Play/Pause" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Lyrics Area -->
    <com.lagradost.cloudstream3.ui.music.SyncedLyricsView
        android:id="@+id/lyrics_synced_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp"
        android:paddingBottom="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lyrics_bottom_controls"
        app:layout_constraintTop_toBottomOf="@id/lyrics_header"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/lyrics_back_to_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Back to current"
        android:textAllCaps="false"
        android:textColor="@color/black"
        app:backgroundTint="@color/white"
        app:cornerRadius="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lyrics_bottom_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <ScrollView
        android:id="@+id/lyrics_plain_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lyrics_bottom_controls"
        app:layout_constraintTop_toBottomOf="@id/lyrics_header">

        <TextView
            android:id="@+id/lyrics_plain_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingVertical="32dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:lineSpacingExtra="8dp"
            tools:text="Plain lyrics go here..." />
    </ScrollView>

    <ProgressBar
        android:id="@+id/lyrics_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lyrics_bottom_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lyrics_header" />

    <TextView
        android:id="@+id/lyrics_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:text="Lyrics not found"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lyrics_bottom_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lyrics_header" />

</androidx.constraintlayout.widget.ConstraintLayout>
