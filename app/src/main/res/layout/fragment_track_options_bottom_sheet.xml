<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/music_rounded_bottom_sheet"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <View
            android:id="@+id/drag_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="#66FFFFFF" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/track_thumbnail_card"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/track_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/default_cover" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/track_thumbnail_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/track_thumbnail_card"
                app:layout_constraintTop_toTopOf="@id/track_thumbnail_card">

                <TextView
                    android:id="@+id/track_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/metropolis_bold"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="Song Title" />

                <TextView
                    android:id="@+id/track_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/metropolis_medium"
                    android:maxLines="1"
                    android:textColor="#B3B3B3"
                    android:textSize="14sp"
                    tools:text="Artist Name" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.1"
            android:background="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_save"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/action_save"
            android:textColor="@color/white"
            app:icon="@drawable/ic_baseline_favorite_border_24"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_playlist"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/action_add_to_playlist"
            android:textColor="@color/white"
            app:icon="@drawable/ic_baseline_add_24"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_queue"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/music_add_to_queue"
            android:textColor="@color/white"
            app:icon="@drawable/ic_baseline_playlist_play_24"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_download"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/download"
            android:textColor="@color/white"
            app:icon="@drawable/netflix_download"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_share"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/result_share"
            android:textColor="@color/white"
            app:icon="@drawable/ic_outline_share_24"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_artist"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/action_go_to_artist"
            android:textColor="@color/white"
            app:icon="@drawable/ic_baseline_people_24"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_lyrics"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/lyrics"
            android:textColor="@color/white"
            app:icon="@drawable/ic_lyrics"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_about"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/action_about_the_song"
            android:textColor="@color/white"
            app:icon="@drawable/ic_outline_info_24"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_radio"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/music_start_radio"
            android:textColor="@color/white"
            app:icon="@drawable/baseline_sync_24"
            app:iconPadding="16dp"
            app:iconTint="@color/white" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
