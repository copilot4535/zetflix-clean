<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zetflix_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/zetflix_card_bg"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_zetflix_logo_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/zetflix_register_subtitle"
                android:textColor="@color/zetflix_text_secondary"
                android:textSize="16sp" />

            <!-- Phone Layout -->
            <LinearLayout
                android:id="@+id/phone_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/country_code_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/zetflix_input_bg"
                    android:paddingEnd="8dp"
                    android:paddingStart="8dp" />

                <EditText
                    android:id="@+id/phone_number_edit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/zetflix_input_bg"
                    android:hint="@string/zetflix_phone_hint"
                    android:inputType="phone"
                    android:paddingEnd="12dp"
                    android:paddingStart="12dp"
                    android:textColor="@color/zetflix_text_primary"
                    android:textColorHint="@color/zetflix_text_hint" />
            </LinearLayout>

            <!-- Email Layout -->
            <EditText
                android:id="@+id/email_edit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/zetflix_input_bg"
                android:hint="@string/zetflix_email_hint"
                android:inputType="textEmailAddress"
                android:paddingEnd="12dp"
                android:paddingStart="12dp"
                android:textColor="@color/zetflix_text_primary"
                android:textColorHint="@color/zetflix_text_hint" />

            <!-- Password Layout -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/password_edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/zetflix_input_bg"
                    android:hint="@string/zetflix_password_hint"
                    android:inputType="textPassword"
                    android:paddingEnd="44dp"
                    android:paddingStart="12dp"
                    android:textColor="@color/zetflix_text_primary"
                    android:textColorHint="@color/zetflix_text_hint" />

                <ImageView
                    android:id="@+id/password_visibility_toggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_baseline_visibility_off_24"
                    app:tint="@color/zetflix_text_secondary" />
            </RelativeLayout>

            <!-- Confirm Password Layout -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/confirm_password_edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/zetflix_input_bg"
                    android:hint="@string/zetflix_confirm_password_hint"
                    android:inputType="textPassword"
                    android:paddingEnd="44dp"
                    android:paddingStart="12dp"
                    android:textColor="@color/zetflix_text_primary"
                    android:textColorHint="@color/zetflix_text_hint" />

                <ImageView
                    android:id="@+id/confirm_password_visibility_toggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_baseline_visibility_off_24"
                    app:tint="@color/zetflix_text_secondary" />
            </RelativeLayout>

            <CheckBox
                android:id="@+id/privacy_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/zetflix_agree_privacy"
                android:textColor="@color/zetflix_text_secondary" />

            <Button
                android:id="@+id/register_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/zetflix_button_bg"
                android:text="@string/zetflix_register_button"
                android:textAllCaps="false"
                android:textColor="@color/zetflix_text_primary"
                android:textSize="18sp"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/login_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/zetflix_login_toggle"
                android:textColor="@color/zetflix_text_primary"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
