<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_navigation"
    app:startDestination="@+id/music_nav_home">

    <fragment
        android:id="@+id/music_nav_home"
        android:name="com.lagradost.cloudstream3.ui.music.MusicHomeFragment"
        android:label="@string/music"
        tools:layout="@layout/fragment_music_home" />

    <fragment
        android:id="@+id/music_nav_search"
        android:name="com.lagradost.cloudstream3.ui.music.MusicSearchFragment"
        android:label="@string/title_search"
        tools:layout="@layout/fragment_music_search">
        <argument
            android:name="search_query"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/music_nav_library"
        android:name="com.lagradost.cloudstream3.ui.music.MusicLibraryFragment"
        android:label="Library"
        tools:layout="@layout/fragment_music_library" />

    <!-- Detail View for Albums and Playlists -->
    <fragment
        android:id="@+id/music_nav_detail"
        android:name="com.lagradost.cloudstream3.ui.music.MusicDetailFragment"
        android:label="Detail"
        tools:layout="@layout/fragment_music_detail">
        <argument
            android:name="album_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="playlist_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Artist Profile -->
    <fragment
        android:id="@+id/music_nav_artist"
        android:name="com.lagradost.cloudstream3.ui.music.MusicArtistFragment"
        android:label="Artist"
        tools:layout="@layout/fragment_music_artist">
        <argument
            android:name="artist_id"
            app:argType="string" />
    </fragment>

    <!-- Genre / Mood Page -->
    <fragment
        android:id="@+id/music_nav_genre"
        android:name="com.lagradost.cloudstream3.ui.music.MusicGenreFragment"
        android:label="Mood"
        tools:layout="@layout/fragment_music_genre">
        <argument
            android:name="params"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />
    </fragment>

    <!-- Music Settings -->
    <fragment
        android:id="@+id/music_nav_settings"
        android:name="com.lagradost.cloudstream3.ui.music.MusicSettingsFragment"
        android:label="Music Settings"
        tools:layout="@layout/fragment_music_settings" />

    <!-- Music Downloads -->
    <fragment
        android:id="@+id/music_nav_downloads"
        android:name="com.lagradost.cloudstream3.ui.music.MusicDownloadsFragment"
        android:label="Downloads"
        tools:layout="@layout/fragment_music_downloads" />

    <!-- Player Destinations -->
    <fragment
        android:id="@+id/navigation_music_player"
        android:name="com.lagradost.cloudstream3.ui.music.MusicPlayerFragment"
        android:label="Player"
        tools:layout="@layout/fragment_music_player" />

    <fragment
        android:id="@+id/navigation_lyrics"
        android:name="com.lagradost.cloudstream3.ui.music.LyricsFragment"
        android:label="Lyrics"
        tools:layout="@layout/fragment_lyrics" />

    <fragment
        android:id="@+id/navigation_music_queue"
        android:name="com.lagradost.cloudstream3.ui.music.MusicQueueFragment"
        android:label="Queue"
        tools:layout="@layout/fragment_music_queue" />

    <dialog
        android:id="@+id/navigation_track_options"
        android:name="com.lagradost.cloudstream3.ui.music.TrackOptionsBottomSheetFragment"
        android:label="Track Options">
        <argument
            android:name="track"
            app:argType="string" />
    </dialog>

    <dialog
        android:id="@+id/navigation_sleep_timer"
        android:name="com.lagradost.cloudstream3.ui.music.SleepTimerBottomSheetFragment"
        android:label="Sleep Timer" />

    <!-- Global actions for easy access from any fragment in the music graph -->
    <action
        android:id="@+id/global_to_navigation_music_player"
        app:destination="@id/navigation_music_player"
        app:enterAnim="@anim/enter_anim"
        app:exitAnim="@anim/exit_anim"
        app:popEnterAnim="@anim/enter_anim"
        app:popExitAnim="@anim/exit_anim" />

    <action
        android:id="@+id/global_to_navigation_lyrics"
        app:destination="@id/navigation_lyrics"
        app:enterAnim="@anim/enter_anim"
        app:exitAnim="@anim/exit_anim"
        app:popEnterAnim="@anim/enter_anim"
        app:popExitAnim="@anim/pop_exit" />

    <action
        android:id="@+id/global_to_navigation_music_queue"
        app:destination="@id/navigation_music_queue"
        app:enterAnim="@anim/enter_anim"
        app:exitAnim="@anim/exit_anim"
        app:popEnterAnim="@anim/enter_anim"
        app:popExitAnim="@anim/exit_anim" />

</navigation>
