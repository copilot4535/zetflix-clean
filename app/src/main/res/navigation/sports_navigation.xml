<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sports_navigation"
    app:startDestination="@id/navigation_zet_sports">

    <fragment
        android:id="@+id/navigation_zet_sports"
        android:name="com.lagradost.cloudstream3.ui.sports.ZetSportsFragment"
        android:label="ZetSports"
        tools:layout="@layout/fragment_livestream" />

    <fragment
        android:id="@+id/navigation_sports_home"
        android:name="com.lagradost.cloudstream3.ui.sports.SportsHomeFragment"
        android:label="Sports Home"
        tools:layout="@layout/fragment_sports_home">
        <action
            android:id="@+id/action_navigation_sports_home_to_matchDetailsFragment"
            app:destination="@id/navigation_match_details" />
        <action
            android:id="@+id/action_navigation_sports_home_to_teamDetailsFragment"
            app:destination="@id/navigation_team_details" />
    </fragment>

    <fragment
        android:id="@+id/navigation_match_details"
        android:name="com.lagradost.cloudstream3.ui.sports.MatchDetailsFragment"
        android:label="Match Details"
        tools:layout="@layout/fragment_match_details">
        <argument
            android:name="match_id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/navigation_team_details"
        android:name="com.lagradost.cloudstream3.ui.sports.TeamDetailsFragment"
        android:label="Team Details"
        tools:layout="@layout/fragment_team_details">
        <argument
            android:name="team_id"
            app:argType="string" />
        <argument
            android:name="team_name"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="team_logo"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="league_shortcut"
            app:argType="string" />
        <argument
            android:name="league_name"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <action
        android:id="@+id/action_global_navigation_match_details"
        app:destination="@id/navigation_match_details" />
</navigation>
